# .shellcheckrc — repo-local shellcheck configuration
#
# This repository vendors install-creator.sh, a working upstream RetroPie-Extra
# script (Exarkuniv/RetroPie-Extra) that uses complex `dialog` + process-
# substitution nesting. shellcheck cannot fully parse those constructs and
# emits cascading false positives (SC1089 "parsing stopped", SC2168 "local
# outside function" that are actually inside functions, SC2199 array-in-[[ ]]
# that are valid membership checks). We fix the genuine issues in-tree and
# disable the purely-noisy ones here so the .github/workflows/ci.yml lint
# job stays green without rewriting 700 lines of upstream code.
#
# Codes disabled (verified non-actionable for this script):
disable=SC1089  # parse stopped — shellcheck limitation on valid bash
disable=SC2168  # 'local' flagged outside function — cascade from SC1089
disable=SC2155  # declare+assign — style only
disable=SC2069  # 2>&1 must be last — intentional in dialog redirection
disable=SC2162  # read without -r — intentional for these inputs
disable=SC2317  # unreachable code — indirect invocation
disable=SC2206  # split command output — intentional word-splitting
disable=SC2207  # mapfile vs split — style
disable=SC2199  # array-in-[[ ]] — works as intended here
# RetroPie scriptmodule framework globals ($romdir, $md_build, $md_inst, ...)
# are provided by rp_module at runtime; shellcheck can't see them.
disable=SC2154  # var referenced but not assigned (framework global)
disable=SC2034  # var assigned but not used (framework global / intentional)
